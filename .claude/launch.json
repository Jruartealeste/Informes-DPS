{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ot-qa",
      "runtimeExecutable": "ot/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "ot/tools/qa_server.py"
      ],
      "port": 8123
    },
    {
      "name": "ot-dev",
      "runtimeExecutable": "ot/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--reload-dir",
        "ot/app",
        "--app-dir",
        "ot"
      ],
      "port": 8000
    },
    {
      "name": "ot-qa-manual",
      "runtimeExecutable": "ot/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "ot/tools/qa_server.py",
        "--sqlite",
        "--reset",
        "--port=8125"
      ],
      "port": 8125
    }
  ]
}
