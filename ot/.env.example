# Usar el endpoint "pooled" de Neon (host con "-pooler" antes de la región,
# ver Dashboard de Neon → Connection Details → toggle "Pooled connection") —
# combinado con NullPool (ver app/db.py) cada request abre una conexión
# nueva, y el endpoint pooled la establece contra PgBouncer en vez de contra
# el compute real, bastante más liviano por conexión.
DATABASE_URL=postgresql+psycopg://user:password@host-pooler/dbname?sslmode=require

# Login (Google OAuth) — requeridos, la app no arranca sin esto (ver
# CLAUDE.md, "Auth"). Credencial DISTINTA a la de Gmail de abajo: tipo
# "Web application" en Google Cloud Console, con redirect URI
# http://localhost:8000/auth/callback en dev (sumar la URL de prod al
# desplegar). SESSION_SECRET: cualquier string random largo, por ejemplo
# `python -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Envío de mail a responsables (Gmail API) — opcional, el resto de la app
# funciona sin esto. Se obtienen corriendo una vez `python -m
# scripts.gmail_authorize` (ver CLAUDE.md, "Mail a responsables").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=javier@aleste.ar
GMAIL_SENDER_NOMBRE=Aleste
